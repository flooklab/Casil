import os
import subprocess
import sys

casilSrcDir = "@CASIL_PRJ_SRC_DIR@"

sys.path.insert(0, os.path.dirname(os.path.dirname(__file__)))

modEnv = os.environ.copy()
modEnv["PYTHONPATH"] = os.pathsep.join(sys.path)
modEnv["BASIL_FIRMWARE_DIR"] = os.path.join(casilSrcDir, "external/basil/basil/firmware")

subprocess.run([sys.executable, os.path.join(casilSrcDir, "tests/co-sim/runTests.py")], env=modEnv)
